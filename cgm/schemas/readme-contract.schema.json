{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-generation.readme-contract.v2",
  "type": "object",
  "required": [
    "schema_version",
    "purpose",
    "required_sections",
    "required_references",
    "scanability_policy",
    "story_policy",
    "evidence_policy",
    "visual_policy",
    "review_questions"
  ],
  "properties": {
    "schema_version": {"const": "content-generation.readme-contract.v2"},
    "purpose": {"type": "string", "minLength": 1},
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "heading", "question"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "heading": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "required_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "scanability_policy": {
      "type": "object",
      "required": ["heading_rule", "bolding_rule", "scan_test", "accessibility_rule"],
      "properties": {
        "heading_rule": {"type": "string", "minLength": 1},
        "bolding_rule": {"type": "string", "minLength": 1},
        "scan_test": {"type": "string", "minLength": 1},
        "accessibility_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "story_policy": {
      "type": "object",
      "required": ["sequence", "worked_example", "reader_paths"],
      "properties": {
        "sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "worked_example": {"type": "string", "minLength": 1},
        "reader_paths": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence_policy": {
      "type": "object",
      "required": ["claim_fields", "supports_rule", "limits_rule", "citation_rule", "truth_boundary"],
      "properties": {
        "claim_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supports_rule": {"type": "string", "minLength": 1},
        "limits_rule": {"type": "string", "minLength": 1},
        "citation_rule": {"type": "string", "minLength": 1},
        "truth_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "visual_policy": {
      "type": "object",
      "required": [
        "use_when",
        "minimum_narrative_images_for_this_helper",
        "required_image_record_fields",
        "required_guides"
      ],
      "properties": {
        "use_when": {"type": "string", "minLength": 1},
        "minimum_narrative_images_for_this_helper": {"type": "integer", "minimum": 0},
        "required_image_record_fields": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_guides": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "review_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
