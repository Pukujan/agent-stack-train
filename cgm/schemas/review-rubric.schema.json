{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-generation.review-rubric.v1",
  "type": "object",
  "required": ["schema_version", "dimensions", "decision_rule"],
  "properties": {
    "schema_version": {"const": "content-generation.review-rubric.v1"},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "decision_rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
