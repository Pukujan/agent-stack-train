{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-generation.project-brief.v2",
  "type": "object",
  "required": ["schema_version", "project", "audience", "problem", "solution", "evidence", "boundaries"],
  "properties": {
    "schema_version": {"const": "content-generation.project-brief.v2"},
    "project": {"type": "string", "minLength": 1},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "problem": {"type": "string", "minLength": 1},
    "solution": {"type": "string", "minLength": 1},
    "mechanism": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminology": {"type": "object"}
  },
  "$defs": {
    "source_revision": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"enum": ["repository_artifact", "external_source", "user_observation", "owner_decision", "experiment_result", "unknown_search"]},
        "reference": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "commit": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date"},
        "accessed_at": {"type": "string", "format": "date"},
        "published_at": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "repository_artifact"}}, "required": ["kind"]},
          "then": {"required": ["repository", "commit", "path", "locator", "uri"]}
        },
        {
          "if": {"properties": {"kind": {"const": "external_source"}}, "required": ["kind"]},
          "then": {"required": ["uri", "accessed_at"]}
        },
        {
          "if": {"properties": {"kind": {"const": "experiment_result"}}, "required": ["kind"]},
          "then": {"required": ["uri", "accessed_at", "locator"]}
        },
        {
          "if": {"properties": {"kind": {"enum": ["user_observation", "owner_decision", "unknown_search"]}}, "required": ["kind"]},
          "then": {"required": ["observed_at"]}
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["claim", "source", "status", "supports", "limits", "source_revision", "recorded_at", "cite_in_readme"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "status": {"enum": ["shipped", "experimentally_supported", "planned", "unknown"]},
        "supports": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1},
        "source_revision": {"$ref": "#/$defs/source_revision"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "valid_time": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": ["string", "null"], "format": "date-time"},
            "end": {"type": ["string", "null"], "format": "date-time"}
          },
          "anyOf": [
            {"properties": {"start": {"type": "string"}}},
            {"properties": {"end": {"type": "string"}}}
          ],
          "additionalProperties": false
        },
        "cite_in_readme": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
