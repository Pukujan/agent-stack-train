{
  "system": "content-generation-modules",
  "version": "0.4.0",
  "status": "draft",
  "purpose": "Reusable agent contract for human-first brand, content, visual, image, and HTML-demo generation.",
  "modules": [
    "brand-foundation",
    "content-context",
    "writing-direction",
    "visual-direction",
    "image-generation",
    "html-demo"
  ],
  "canonical_files": [
    "project-brief.json",
    "brand-language.json",
    "visual-style.json",
    "asset-manifest.json",
    "review-rubric.json"
  ],
  "helper_contract_files": [
    "templates/readme-contract.json",
    "templates/project-brief.json",
    "schemas/readme-contract.schema.json",
    "schemas/project-brief.v2.schema.json",
    "docs/CONTENT_RESEARCH.md",
    "docs/BRAND_DIRECTION.md",
    "docs/README_PLAYBOOK.md",
    "docs/README_QUALITY_PDD.md",
    "docs/README_QUALITY_SDD.md",
    "docs/README_QUALITY_TDD.md",
    "docs/PROVENANCE_AND_CITATION.md",
    "docs/REVERSE_ANALYSIS_PCM_AND_ADOPTERS.md",
    "docs/IMAGE_GUIDE.md",
    "docs/PRIOR_WORK.md",
    "docs/HOLDOUT_EVALUATION.md",
    "docs/MIGRATING_TO_0.2.md",
    "docs/MIGRATING_TO_0.3.md",
    "docs/MIGRATING_TO_0.4.md"
  ],
  "human_output_contract": {
    "version": "content-generation.readme-contract.v2",
    "template": "templates/README.template.md",
    "playbook": "docs/README_PLAYBOOK.md",
    "image_guide": "docs/IMAGE_GUIDE.md",
    "prior_work": "docs/PRIOR_WORK.md",
    "research": "docs/CONTENT_RESEARCH.md",
    "brand_direction": "docs/BRAND_DIRECTION.md",
    "holdout_evaluation": "docs/HOLDOUT_EVALUATION.md",
    "product_definition": "docs/README_QUALITY_PDD.md",
    "system_design": "docs/README_QUALITY_SDD.md",
    "test_design": "docs/README_QUALITY_TDD.md",
    "provenance": "docs/PROVENANCE_AND_CITATION.md",
    "reverse_analysis": "docs/REVERSE_ANALYSIS_PCM_AND_ADOPTERS.md",
    "technical_details_order": "after-human-story"
  },
  "claim_explanation_contract": {
    "version": "content-generation.claim-evidence.v2",
    "fields": ["claim", "source", "status", "supports", "limits", "source_revision", "recorded_at"],
    "optional_fields": ["valid_time"],
    "temporal_model": "recorded_at is transaction time; valid_time describes when a time-bound claim applies",
    "truth_boundary": "citation establishes traceability, not truth",
    "required_for_helper_version": "0.4.0"
  },
  "scanability_contract": {
    "version": "content-generation.scanability.v1",
    "heading_rule": "Use descriptive headings that tell the reader what they will learn or gain.",
    "bolding_rule": "Use one short meaningful anchor when helpful, usually 2–8 words, for a problem, outcome, mechanism, proof, or boundary.",
    "scan_test": "Read only headings, bold phrases, and link text; they should communicate the problem, promise, mechanism, boundary, and next action.",
    "accessibility_rule": "Keep the text understandable when bold styling disappears and use semantic headings for structure."
  },
  "quality_model": {
    "objective": "deterministic checks and repository evidence",
    "advisory": "model-assisted rubric scores",
    "final": "human review"
  }
}
